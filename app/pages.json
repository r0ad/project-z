{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^nut-(.*)?-(.*)": "nutui-uniapp/components/$1$2/$1$2.vue",
      "^nut-(.*)": "nutui-uniapp/components/$1/$1.vue"
    }
  },
  "pages": [
    //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "uni-app"
      }
    },
    {
      "path": "pages/demo/index",
      "style": {
        "navigationBarTitleText": "示例"
      }
    },
    {
      "path": "pages/demo/gitcode-demo/gitcode-demo",
      "style": {
        "navigationBarTitleText": "GitCode同步示例"
      }
    },
    {
      "path": "pages/demo/file-demo/file-demo",
      "style": {
        "navigationBarTitleText": "文件管理示例"
      }
    },
    {
      "path": "pages/demo/update-demo/update-demo",
      "style": {
        "navigationBarTitleText": "应用更新示例"
      }
    },
    {
      "path": "pages/demo/plugin-example/plugin-example",
      "style": {
        "navigationBarTitleText": "插件使用示例"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "uni-app",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  },
  "uniIdRouter": {}
}
