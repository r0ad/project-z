    "@vue/compiler-sfc": "^3.5.21",
    "@vue/test-utils": "^2.4.0",
    "@vue/vue3-jest": "^29.2.6",
    "adbkit": "^2.11.1",
    "babel-jest": "^27.5.1",
    "cross-env": "^7.0.3",
    "jest": "^27.0.4",
    "jest-environment-jsdom": "^30.1.2",
