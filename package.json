{
  "name": "project-z",
  "version": "1.0.6",
  "description": "点点 - 本地优先的 AI 项目管理应用（uni-app + Vue 3 + SQLite）",
  "license": "MIT",
  "author": "r0ad <sunzroad@gmail.com>",
  "private": false,
  "keywords": [
    "uni-app",
    "vue3",
    "ai",
    "project-management",
    "sqlite",
    "nutui-uniapp",
    "offline-first",
    "productivity"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --config tests/jest.config.unit.js",
    "test:app": "jest --config tests/jest.config.app.js",
    "test:pages": "jest --config tests/jest.config.pages.js",
    "test:h5": "cross-env UNI_PLATFORM=h5 jest -i",
    "test:android": "cross-env UNI_PLATFORM=app-plus UNI_OS_NAME=android jest -i",
    "test:ios": "cross-env UNI_PLATFORM=app-plus UNI_OS_NAME=ios jest -i",
    "test:mp-weixin": "cross-env UNI_PLATFORM=mp-weixin jest -i",
    "test:mp-baidu": "cross-env UNI_PLATFORM=mp-baidu jest -i",
    "build:app": "node scripts/build.mjs app",
    "build:h5": "node scripts/build.mjs h5",
    "release:apk": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4070620250821001",
    "@dcloudio/uni-app-plus": "3.0.0-4070620250821001",
    "@dcloudio/uni-components": "3.0.0-4070620250821001",
    "@dcloudio/uni-h5": "3.0.0-4070620250821001",
    "nutui-uniapp": "^1.8.4",
    "vue": "3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@dcloudio/uni-automator": "^2.0.2-4070620250821001",
    "@dcloudio/uni-cli-shared": "^3.0.0-4070620250821001",
    "@dcloudio/vite-plugin-uni": "^3.0.0-4070620250821001",
    "@vue/compiler-sfc": "^3.5.21",
    "@vue/test-utils": "^2.4.0",
    "@vue/vue3-jest": "^29.2.6",
    "adbkit": "^2.11.1",
    "babel-jest": "^27.5.1",
    "cross-env": "^7.0.3",
    "jest": "^27.0.4",
    "jest-environment-jsdom": "^30.1.2",
    "jest-environment-node": "^27.5.1",
    "node-simctl": "^8.0.3",
    "sass": "^1.90.0",
    "vite": "^5.2.8"
  }
}
